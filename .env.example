# Copia este archivo como ".env" y cambia los valores.

# Claves para firmar los tokens. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-otra-clave

# Base de datos. Si se omite, se usa SQLite en instance/zarape.db
# Ejemplo MySQL: mysql+pymysql://usuario:password@localhost/zarape
# DATABASE_URL=sqlite:///zarape.db

# Orígenes (frontends) que pueden consumir la API, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Usuario administrador que crea el comando "flask seed"
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123
